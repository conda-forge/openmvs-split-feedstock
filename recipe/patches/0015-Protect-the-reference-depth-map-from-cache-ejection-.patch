From 7566757ab499191204a06d7fd07371c31ea9dbe6 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <info@tobiasfischer.info>
Date: Fri, 30 Oct 2026 08:43:38 +1000
Subject: [PATCH 15/15] Protect the reference depth-map from cache ejection
 during fusion

DMapCache::UseImage() loads a depth-map and then ejects the least recently
used ones until the cache fits its memory budget. The fusion loops marked the
reference depth-map as protected (SkipMemoryCheckIdxImage) only after loading
it, so with a budget smaller than one depth-map the reference itself was
ejected and fusion read its released depth-map (null dereference in
DenseFuseDepthMaps). The budget comes from the free physical memory, so this
happened at random on machines under memory pressure. Protect the reference
before loading it; neighbors loaded afterwards are newer and are kept too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/MVS/SceneDensify.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/libs/MVS/SceneDensify.cpp b/libs/MVS/SceneDensify.cpp
index 2c935fb..4b1c309 100644
--- a/libs/MVS/SceneDensify.cpp
+++ b/libs/MVS/SceneDensify.cpp
@@ -1435,8 +1435,11 @@ void DepthMapsData::FuseDepthMaps(PointCloud& pointcloud, bool bEstimateColor, b
 		totalNumImageNeighborsInCache += numImageNeighborsInCache;
 		totalNumImagesInCache += numImagesInCache;
 		// fuse depth-map
-		cacheDMaps.UseImage(idxImage);
+		// protect the reference before loading it: UseImage() ejects the least recently
+		// used depth-maps to fit the memory budget, which would otherwise include the
+		// reference itself when the budget is smaller than one depth-map
 		cacheDMaps.SkipMemoryCheckIdxImage(idxImage);
+		cacheDMaps.UseImage(idxImage);
 		const DepthData& depthData(arrDepthData[idxImage]);
 		ASSERT(depthData.GetView().GetLocalID(scene.images) == idxImage);
 		ASSERT(!depthData.IsEmpty());
@@ -1770,8 +1773,11 @@ void DepthMapsData::DenseFuseDepthMaps(PointCloud& pointcloud, bool bEstimateCol
 		totalNumImagesInCache += numImagesInCache;
 		++numDMapsFused;
 		// fuse depth-map
-		cacheDMaps.UseImage(idxImage);
+		// protect the reference before loading it: UseImage() ejects the least recently
+		// used depth-maps to fit the memory budget, which would otherwise include the
+		// reference itself when the budget is smaller than one depth-map
 		cacheDMaps.SkipMemoryCheckIdxImage(idxImage);
+		cacheDMaps.UseImage(idxImage);
 		const DepthData& depthData(arrDepthData[idxImage]);
 		ASSERT(depthData.GetView().GetLocalID(scene.images) == idxImage);
 		ASSERT(!depthData.IsEmpty());
