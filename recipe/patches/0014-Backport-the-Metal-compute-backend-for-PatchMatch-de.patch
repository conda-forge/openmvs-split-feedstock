new file mode 100644
index 0000000..eea1d9d
--- /dev/null
+++ b/libs/MVS/PatchMatchMetal.metal
@@ -0,0 +1,529 @@
+/*
+* PatchMatchMetal.metal
+*
+* Copyright (c) 2014-2026 SEACAVE
+*
+* Author(s):
+*
+*      cDc <cdc.seacave@gmail.com>
+*
