From 7a033c82d679327fa4f92e04c496a6eabccafe7f Mon Sep 17 00:00:00 2001
From: Tobias Fischer <info@tobiasfischer.info>
Date: Fri, 30 Oct 2026 07:38:30 +1000
Subject: [PATCH 14/15] Backport the Metal compute backend for PatchMatch
 densification

Minimal backport of the Metal PatchMatch backend (cdcseacave/openMVS#1279,
merge commit 4694dedd9) onto 2.4.0: PatchMatchMetal.{h,metal,mm} unchanged,
CMake/ConfigLocal hooks, and a single Metal PatchMatch instance in
SceneDensify driven like 2.4.0's single CUDA instance (selected with
--gpu-device: -1 default GPU, -2 CPU). The CUDA instance pool and the
multi-GPU device list of #1279 depend on later develop changes and are left
out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                               |  16 +
 apps/DensifyPointCloud/DensifyPointCloud.cpp |   3 +
 build/Templates/ConfigLocal.h.in             |   3 +
 libs/MVS/CMakeLists.txt                      |  25 +
 libs/MVS/PatchMatchMetal.h                   |  90 ++++
 libs/MVS/PatchMatchMetal.metal               | 529 +++++++++++++++++++
 libs/MVS/PatchMatchMetal.mm                  | 403 ++++++++++++++
 libs/MVS/SceneDensify.cpp                    |  29 +
 libs/MVS/SceneDensify.h                      |  11 +
 9 files changed, 1109 insertions(+)
 create mode 100644 libs/MVS/PatchMatchMetal.h
 create mode 100644 libs/MVS/PatchMatchMetal.metal
 create mode 100644 libs/MVS/PatchMatchMetal.mm

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a42cde2..1ca5c32 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -213,6 +213,22 @@ if(OpenMVS_USE_CUDA)
 	endif()
 endif()
 
+# Metal compute backend on Apple (replaces CUDA, which is disabled on macOS above)
+IF(APPLE)
+	FIND_LIBRARY(METAL_FRAMEWORK Metal)
+	FIND_LIBRARY(FOUNDATION_FRAMEWORK Foundation)
+	IF(METAL_FRAMEWORK AND FOUNDATION_FRAMEWORK)
+		ENABLE_LANGUAGE(OBJCXX)
+		SET(CMAKE_OBJCXX_STANDARD 17)
+		SET(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
+		SET(_USE_METAL TRUE)
+		LIST(APPEND OpenMVS_EXTRA_LIBS ${METAL_FRAMEWORK} ${FOUNDATION_FRAMEWORK})
+		MESSAGE(STATUS "Enabling Metal compute backend on macOS")
+	ELSE()
+		MESSAGE(STATUS "Metal/Foundation frameworks not found; Metal backend disabled")
+	ENDIF()
+ENDIF()
+
 if(OpenMVS_USE_BREAKPAD)
 	FIND_PACKAGE(BREAKPAD QUIET)
 	if(BREAKPAD_FOUND)
